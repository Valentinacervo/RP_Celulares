<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- FONTE (Garet) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    
    <link rel='stylesheet' href='/stylesheets/style.css' />
       
    <!-- ICONES -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
        
    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <title>Cadastro</title>
</head>

<body>

  <%- include("partials/navbar2_cadastro-login") %>



<!--FORMULÁRIO-->
<div class="cadastro-container">

  <h2>SEJA BEM-VINDO A RP CELULARES!</h2>

  <div class="cadastro-box">
    <h3>CADASTRE-SE AQUI</h3>

      <!-- Mensagem de Erro -->
      <% if (typeof erro !== 'undefined' && erro) { %>
        <p><%= erro %></p>
      <% } %>

    <form action="/cadastro" method="POST">

      <!-- Nome -->
      <div class="input-box full">
        <i class="bi bi-person-fill"></i>
        <input type="text" name="nome" placeholder="Nome Completo" required>
      </div>

      <!-- Telefone + Email -->
      <div class="input-box">
          <i class="bi bi-telephone-fill"></i>
          <input 
              type="text" 
              name="telefone" 
              placeholder="(00) 00000-0000" 
              maxlength="15"
              pattern="\(\d{2}\) \d{5}-\d{4}"
              title="Formato esperado: (00) 00000-0000"
              required>
      </div>

      <div class="input-box">
          <i class="bi bi-envelope-fill"></i>
        <input type="email" name="email" placeholder="E-mail" required>
      </div>
  

      <!-- Senhas -->
      <div class="row">
        <div class="input-box senha-box">
          <i class="bi bi-lock-fill"></i>
          <input type="password" name="senha" id="senhaCadastro" placeholder="Senha" required>
          <i class="bi bi-eye-slash toggle-senha" data-target="senhaCadastro"></i>
        </div>

        <div class="input-box senha-box">
          <i class="bi bi-lock-fill"></i>
          <input type="password" name="confirmarSenha" id="confirmarSenha" placeholder="Confirme sua senha" required>
          <i class="bi bi-eye-slash toggle-senha" data-target="confirmarSenha"></i>
        </div>
      </div>

      <!-- Data de Nascimento Dinâmica -->
      <p class="data-label">Data de Nascimento</p>

      <div class="data-row">
          <!-- Dia -->
          <select name="dia" required>
              <option value="" disabled selected>Dia</option>
              <% for(let i=1; i<=31; i++) { %>
                  <option value="<%= i %>"><%= i %></option>
              <% } %>
          </select>

          <!-- Mês -->
          <select name="mes" required>
              <option value="" disabled selected>Mês</option>
              <% const meses = ["Janeiro", "Fevereiro", "Março", "Abril", "Maio", "Junho", "Julho", "Agosto", "Setembro", "Outubro", "Novembro", "Dezembro"]; %>
              <% meses.forEach((mes, index) => { %>
                  <option value="<%= index + 1 %>"><%= mes %></option>
              <% }); %>
          </select>

          <!-- Ano -->
          <select name="ano" required>
              <option value="" disabled selected>Ano</option>
              <% 
                 let anoAtual = new Date().getFullYear();
                 for(let i = anoAtual; i >= anoAtual - 100; i--) { 
              %>
                  <option value="<%= i %>"><%= i %></option>
              <% } %>
          </select>
      </div>

      <!-- Botão -->
      <button type="submit" class="btn-login">PRÓXIMO</button>

      <!-- Login -->
      <p class="login-link" style="color: black;">
        Já possui uma conta? <a href="/login" style="color: black">Faça login</a>
      </p>

    </form>
  </div>
</div>


<script>
  // MOSTRAR / ESCONDER SENHA 
  const toggles = document.querySelectorAll(".toggle-senha");

  toggles.forEach(toggle => {
    toggle.addEventListener("click", () => {
      const inputId = toggle.getAttribute("data-target");
      const input = document.getElementById(inputId);

      if (input.type === "password") {
        input.type = "text";
        toggle.classList.remove("bi-eye-slash");
        toggle.classList.add("bi-eye");
      } else {
        input.type = "password";
        toggle.classList.remove("bi-eye");
        toggle.classList.add("bi-eye-slash");
      }
    });
  });

  // VALIDAÇÃO DE SENHA IGUAL
  const form = document.querySelector("form");

  form.addEventListener("submit", function(e) {
    const senha = document.getElementById("senhaCadastro").value;
    const confirmar = document.getElementById("confirmarSenha").value;

    if (senha !== confirmar) {
      e.preventDefault();
      alert("As senhas digitadas não coincidem. Por favor, verifique sua senha!");
    }
  });

  // MÁSCARA DE TELEFONE (Para verificar se está dentro do parametro)
const inputTelefone = document.querySelector('input[name="telefone"]');

inputTelefone.addEventListener('input', function() {
    let v = this.value.replace(/\D/g, '').slice(0, 11);

    if (v.length > 6) {
        v = v.replace(/^(\d{2})(\d{5})(\d{0,4}).*/, '($1) $2-$3');
    } else if (v.length > 2) {
        v = v.replace(/^(\d{2})(\d{0,5})/, '($1) $2');
    } else if (v.length > 0) {
        v = v.replace(/^(\d*)/, '($1');
    }

    this.value = v;
});
</script>
</body>
</html>
