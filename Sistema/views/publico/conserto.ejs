<!DOCTYPE html>
<html>
<head>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <!-- FONTE (Garet) -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Conserto</title>
</head>
<body>

    <%- include("partials/navbar") %>

    <!-- AREA CONSERTOS -->
    <section class="conserto-hero">
      <div class="conserto-hero-text">
        <h1>O SEU DISPOSITIVO ESTÁ COM PROBLEMA?</h1>
        <p class="frase">A RP Celulares conta com técnicos altamente qualificados e equipamentos de ponta para garantir o melhor resultado.</p>
        <a href="https://wa.me/" target="_blank" class="btn-whatsapp" style="font-size: 14px">
          <i class="bi bi-whatsapp" style="font-size: 14px;" ></i> Entre em contato via WhatsApp
        </a>
      </div>

      <div class="conserto-hero-image">
        <img src="/images/celular-quebrado.jpeg" alt="Dispositivo com problema">
      </div>
    </section>

    <div class="linha"></div>

    <section class="servicos">
      <h2>Conheça os nossos serviços</h2>
      <div class="servicos-grid">
        <div class="servico-card">
          <i class="bi bi-phone-fill"></i>
          <p>Troca de tela</p>
        </div>
        <div class="servico-card">
          <i class="bi bi-battery-half"></i>
          <p>Troca de bateria</p>
        </div>
        <div class="servico-card">
          <i class="bi bi-droplet-half"></i>
          <p>Desoxidação de eletrônicos</p>
        </div>
        <div class="servico-card">
          <i class="bi bi-arrow-repeat"></i>
          <p>Restauração de software</p>
        </div>
      </div>
    </section>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
