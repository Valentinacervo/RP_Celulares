<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>RP Celulares</title>
</head>

<body>

    <%- include("partials/navbar") %>

    <section class="sobre-hero">
      <div class="hero-text">
        <h1>TECNOLOGIA EM BOAS MÃOS</h1>

        <p>
          Assistência técnica e acessórios eletrônicos em um só lugar.
          Fornecemos um conserto confiável,
          produtos de qualidade e com garantia.
        </p>

      </div>

      <!-- IMAGEM -->
      <div class="hero-image">
        <img src="/images/sobreNos_eletronicos.png" alt="Eletrônicos">
      </div>
    </section>

    <div class="linha"></div>
      <section class="sobre-info">

      <!-- Bloco 1 -->
      <div class="info-box">
        <i class="bi bi-geo-alt info-icon"></i>
        <img src="/images/lojaRP.jpeg" class="fotoSobre" alt="Loja RP">

        <p>
          Estamos localizados no centro de Jacinto Machado (SC),
          com fácil <br> acesso e atendimento presencial de segunda a sábado.
        </p>
      </div>

      <!-- Bloco 2 -->
      <div class="info-box">
        <i class="bi bi-wrench info-icon"></i>
        <img src="/images/lojaRP2.jpeg" alt="Conserto" class="fotoRP">

        <p>
          Atuamos desde 2017 no setor de assistência técnica,
          sempre oferecendo atendimento transparente e serviços de qualidade.
        </p>
      </div>
    </section>

    
<!-- RODAPÉ -->
<footer class="rodape-rp">
    <div class="rodape-container">

        <!-- LADO ESQUERDO: INFORMAÇÕES DA LOJA -->
        <div class="rodape-institucional">

            <h2 class="rodape-titulo">
                <i class="bi bi-tools"></i>
                RP Celulares
            </h2>

            <p class="rodape-slogan">
                Tecnologia e cuidado para manter você 
                sempre conectado.
            </p>

            <!-- REDES SOCIAIS -->
            <div class="rodape-redes">
                <a href="https://www.instagram.com/rp_celulares21/"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Instagram">
                    <i class="bi bi-instagram"></i>
                </a>

                <a href="https://www.facebook.com/"
                   target="_blank"
                   rel="noopener noreferrer"
                   aria-label="Facebook">
                    <i class="bi bi-facebook"></i>
                </a>

            </div>

            <!-- HORÁRIO DE FUNCIONAMENTO -->
            <p class="rodape-horario">
                <i class="bi bi-clock"></i>
                <span>Segunda a Sexta das 08h às 18h</span>
            </p>

        </div>

        <!-- LADO DIREITO: CONTATO -->
        <div class="rodape-contato">

            <h3>Contato</h3>

            <ul>
                <li>
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>
                        Rua Irmãos Trevisol, 1129 — Centro, Jacinto Machado - SC, CEP 88950-000
                    </span>
                </li>

                <li>

                <li>
                    <i class="bi bi-telephone-fill"></i>
                    <a href="tel:+5500000000000">
                        (48) 98807-6959
                    </a>
                </li>

                <li>
                    <i class="bi bi-envelope-fill"></i>
                    <a href="mailto:contato.rpcelulares@gmail.com">
                        contato.rpcelulares@gmail.com
                    </a>
                </li>
            </ul>

        </div>

    </div>
</footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>