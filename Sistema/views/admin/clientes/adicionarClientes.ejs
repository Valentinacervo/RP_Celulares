<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adicionar cliente - RP Celulares</title>
    <link rel="stylesheet" href="/stylesheets/admin.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body>
<header class="navbar">
    <div class="logo">RP</div>

    <nav class="nav-buttons">
        <a href="/admin">Consertos</a>
        <a href="/admin/clientes" class="active">Clientes</a>
    </nav>

    <form class="search-area" action="/admin/clientes" method="GET">
        <input type="text" name="busca" placeholder="Buscar por código, nome ou telefone">
        <i class="bi bi-search search-icon"></i>
    </form>

    <div class="user-menu-container">
      <div class="user">
        <i class="bi bi-person-circle user-icon"></i>
        <span>Admin - Rodrigo</span>
      </div>

      <div class="user-dropdown">
        <a href="/logout" class="btn-sair">
          <i class="bi bi-box-arrow-right"></i> Sair do sistema
        </a>
      </div>
    </div>
</header>


<main class="content content-centralizado">
    <h1>Cadastrar novo cliente <i class="bi bi-person-plus-fill"></i></h1>
    <hr id="linhaPainel">

    <% if (erro) { %>
        <div class="mensagem mensagem--erro"><%= erro %></div>
    <% } %>

    <div class="form-wrapper">
        <form action="/admin/clientes/adicionar" method="POST">

            <!-- 1: DADOS PESSOAIS -->
            <div class="form-card">
                <h3>Dados pessoais:</h3>

                <div class="campo">
                    <label for="nome">Nome completo <span class="obrigatorio">*</span></label>
                    <input type="text" id="nome" name="nome" maxlength="100" required>
                </div>

                <div class="form-grid-2">
                    <div class="campo">
                        <label for="cpf">CPF <span class="obrigatorio">*</span></label>
                        <input type="text" id="cpf" name="cpf" placeholder="000.000.000-00" maxlength="14" required>
                    </div>
                    <div class="campo">
                        <label for="data_nasc">Data de nascimento <span class="obrigatorio">*</span></label>
                        <input type="date" id="data_nasc" name="data_nasc" required>
                    </div>
                </div>
            </div>

            <!-- 2: CONTATO -->
            <div class="form-card">
                <h3>Contato:</h3>

                <div class="form-grid-2">
                    <div class="campo">
                        <label for="telefone">Telefone <span class="obrigatorio">*</span></label>
                        <input type="text" id="telefone" name="telefone" placeholder="(00) 00000-0000" maxlength="15" required>
                    </div>
                    <div class="campo">
                        <label for="email">E-mail <span class="obrigatorio">*</span></label>
                        <input type="email" id="email" name="email" required>
                    </div>
                </div>

                <div class="campo">
                    <label for="contato_adicional">Contato adicional (opcional)</label>
                    <input type="text" id="contato_adicional" name="contato_adicional" placeholder="(00) 00000-0000" maxlength="15">
                </div>
            </div>

            <!-- 3: ENDEREÇO -->
            <div class="form-card">
                <h3>Endereço:</h3>

                <div class="campo">
                    <label for="rua">Rua / Avenida <span class="obrigatorio">*</span></label>
                    <input type="text" id="rua" name="rua" maxlength="30" required>
                </div>

                <div class="form-grid-2">
                    <div class="campo">
                        <label for="numero">Número <span class="obrigatorio">*</span></label>
                        <input type="number" id="numero" name="numero" required>
                    </div>
                    <div class="campo">
                        <label for="complemento">Complemento <span class="obrigatorio">*</span></label>
                        <input type="text" id="complemento" name="complemento" maxlength="50" placeholder="Apto, casa, ponto de referência..." required>
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="campo">
                        <label for="bairro">Bairro <span class="obrigatorio">*</span></label>
                        <input type="text" id="bairro" name="bairro" maxlength="50" required>
                    </div>
                    <div class="campo">
                        <label for="cep">CEP <span class="obrigatorio">*</span></label>
                        <input type="text" id="cep" name="cep" maxlength="9" placeholder="00000-000" required>
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="campo">
                        <label for="cidade">Cidade <span class="obrigatorio">*</span></label>
                        <input type="text" id="cidade" name="cidade" maxlength="50" value="Jacinto Machado" required>
                    </div>
                    <div class="campo">
                        <label for="id_uf">Estado <span class="obrigatorio">*</span></label>
                        <select id="id_uf" name="id_uf" required>
                            <option value="">Selecione</option>
                            <% ufs.forEach(uf => { %>
                                <option value="<%= uf.id_uf %>"><%= uf.descricao %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
            </div>


            <div class="form-botoes">
                <a href="/admin/clientes" class="btn-cancelar">Cancelar</a>
                <button type="submit" class="btn-salvar">
                    <i class="bi bi-floppy2-fill"></i> Cadastrar Cliente
                </button>
            </div>

        </form>
    </div>
</main>

<script>
    // MÁSCARA DE TELEFONE (reaproveitada nos dois campos)
    function aplicarMascaraTelefone(input) {
        input.addEventListener('input', function() {
            let v = this.value.replace(/\D/g, '').slice(0, 11);
            if (v.length > 6) {
                v = v.replace(/^(\d{2})(\d{4,5})(\d{0,4}).*/, '($1) $2-$3');
            } else if (v.length > 2) {
                v = v.replace(/^(\d{2})(\d{0,5})/, '($1) $2');
            } else if (v.length > 0) {
                v = v.replace(/^(\d*)/, '($1');
            }
            this.value = v;
        });
    }
    aplicarMascaraTelefone(document.getElementById('telefone'));
    aplicarMascaraTelefone(document.getElementById('contato_adicional'));

    // MÁSCARA DE CPF
    document.getElementById('cpf').addEventListener('input', function() {
        let v = this.value.replace(/\D/g, '').slice(0, 11);
        v = v.replace(/(\d{3})(\d)/, '$1.$2');
        v = v.replace(/(\d{3})(\d)/, '$1.$2');
        v = v.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
        this.value = v;
    });
</script>
</body>
</html>