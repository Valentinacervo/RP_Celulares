<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gestão de Clientes - RP Celulares</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/stylesheets/admin.css">
</head>
<body class="bg-light">

    <%- include("../partials/navbar" ) %>

    <div class="d-flex">
        <%- include("../partials/sidebarClientes") %>

        <main class="content flex-grow-1 p-4">
            <div class="text-center mb-4">
                <h2 class="fw-bold">Gestão de Clientes</h2>
                <div class="linha-titulo mx-auto"></div>
            </div>

            <div class="container-cards">
                <% if (clientes && clientes.length > 0) { %>
                    <% clientes.forEach(cliente => { %>
                        <div class="card-cliente shadow-sm mb-4 p-3">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h4 class="mb-1 fw-bold"><%= cliente.nome %> <span class="text-muted fs-6 ms-2">#CLI<%= String(cliente.id).padStart(3, '0') %></span></h4>
                                    <div class="info-contato d-flex gap-4 mt-2">
                                        <span><i class="bi bi-telephone"></i> <%= cliente.telefone || '(00) 0000-0000' %></span>
                                        <span><i class="bi bi-envelope"></i> <%= cliente.email || 'email@exemplo.com' %></span>
                                    </div>
                                    <div class="mt-2 text-muted">
                                        <i class="bi bi-geo-alt"></i> <%= cliente.endereco || 'Endereço não cadastrado' %>
                                    </div>
                                </div>
                                <button class="btn btn-outline-dark btn-sm rounded-pill px-3">
                                    <i class="bi bi-eye"></i> Ver Detalhes
                                </button>
                            </div>
                            
                            <hr class="my-3">
                            
                            <div class="servico-info">
                                <p class="mb-1"><strong>Último serviço:</strong> <%= cliente.ultimo_servico || 'Nenhum serviço registrado' %></p>
                                <h3 class="text-success fw-bold mt-2">R$ <%= cliente.valor_total || '0,00' %></h3>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <div class="alert alert-info text-center">Nenhum cliente encontrado.</div>
                <% } %>
            </div>
        </main>
    </div>

</body>
</html>
