<!DOCTYPE html> 
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adicionar produto - RP Celulares</title>
    <link rel="stylesheet" href="/stylesheets/admin.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body>
<header class="navbar">
    <div class="logo">
        RP 
    </div>

    <nav class="nav-buttons">
        <a href="/admin">Consertos</a>
        <a href="/admin/produtos" class="active">Produtos</a>
        <a href="/admin/clientes">Clientes</a>
    </nav>
    
    <div class="search-area">
        <input type="text" id="txtBusca" placeholder="Procurar produto">
        <i class="bi bi-search search-icon"></i>
    </div>

    <!-- Área do Admin com Dropdown-->
    <div class="user-menu-container">
        <div class="user">
            <img src="<%= usuario.foto || '/images/valentina.jpg' %>" class="user-photo" id="fotoPerfil" alt="Foto do usuário">
            <span>Admin - Rodrigo </span>
        </div>
        
        <div class="user-dropdown">
            <a href="#" id="btnMudarFoto">
                <i class="bi bi-camera-fill"></i> Mudar foto
            </a>
            <a href="/logout" class="btn-sair">
                <i class="bi bi-box-arrow-right"></i> Sair do sistema
            </a>
        </div>
    </div>

    <!-- FORMULÁRIO ESCONDIDO PARA UPLOAD -->
    <form id="formFoto" action="/admin/upload-foto" method="POST" enctype="multipart/form-data" style="display: none;">
        <input type="file" id="inputFoto" name="foto" accept="image/*">
    </form>
</header>

    <!-- MENU LATERAL -->
    <aside class="sidebar">
        <ul>
            <li class="<%= paginaAtual === 'inicio' ? 'active' : '' %>">
                <a href="/admin/produtos">
                    <i class="bi bi-house-fill"></i>
                    <span>Início</span>
                </a>
            </li>
            <li class="<%= paginaAtual === 'adicionar-produto' ? 'active' : '' %>">
                <a href="/admin/produtos/adicionar">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Adicionar produtos</span>
                </a>
            </li>
            <li>
                <a href="#" onclick="abrirModalCategoria(); return false;">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Adicionar categoria</span>
                </a>
            </li>

            <hr>

            <% categorias.forEach(categoria => { %>
                <li class="categoria-item <%= categoriaSelecionada == categoria.id_categoria ? 'active' : '' %>">
                    <a href="/admin/produtos?categoria=<%= categoria.id_categoria %>">
                        <span><%= categoria.nome %></span>
                    </a>
                    <button type="button" class="btn-excluir-categoria"
                            onclick="abrirModalExcluirCategoria('<%= categoria.id_categoria %>', '<%= categoria.nome %>')"
                            title="Excluir categoria">
                        <i class="bi bi-trash-fill"></i>
                    </button>
                </li>
            <% }) %>
        </ul>
    </aside>

    <!-- ÁREA PRINCIPAL -->
    <main class="content">
        <h1>Cadastre um Novo Produto <i class="bi bi-box-seam"></i></h1>
        <hr id="linhaPainel">

        <% if (erro) { %>
            <div class="mensagem mensagem--erro"><%= erro %></div>
        <% } %>

    <div class="form-wrapper">
        <form action="/admin/produtos/adicionar" method="POST" enctype="multipart/form-data">

            <!-- 1: DADOS DO PRODUTO -->
            <div class="form-card">
                <h3>Dados do Produto:</h3>

                <div class="campo">
                    <label for="nome">Nome do produto <span class="obrigatorio">*</span></label>
                    <input type="text" id="nome" name="nome" maxlength="50" required>
                </div>

                <div class="form-grid-2">
                    <div class="campo">
                        <label for="foto">Foto do produto <span class="obrigatorio">*</span></label>
                        <input type="file" id="foto" name="foto" accept="image/*" required>
                    </div>
                    <div class="campo">
                        <label for="id_categoria">Categoria <span class="obrigatorio">*</span></label>
                        <select id="id_categoria" name="id_categoria" required>
                            <option value="">Selecione</option>
                            <% categorias.forEach(categoria => { %>
                                <option value="<%= categoria.id_categoria %>"><%= categoria.nome %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>

                <div class="campo">
                    <label for="descricao">Descrição</label>
                    <textarea id="descricao" name="descricao" maxlength="500" rows="3"></textarea>
                </div>
            </div>

            <!-- 2: ESPECIFICAÇÕES -->
            <div class="form-card">
                <h3>Especificações:</h3>

                <div class="form-grid-2">
                    <div class="campo">
                        <label for="marca">Marca <span class="obrigatorio">*</span></label>
                        <input type="text" id="marca" name="marca" maxlength="50" required>
                    </div>
                    <div class="campo">
                        <label for="material">Material (opcional)</label>
                        <input type="text" id="material" name="material" maxlength="20">
                    </div>
                </div>

                <div class="form-grid-2">
                    <div class="campo">
                        <label for="medidas">Medidas (opcional)</label>
                        <input type="number" id="medidas" name="medidas">
                    </div>
                    <div class="campo">
                        <label for="garantia_meses">Garantia (meses) <span class="obrigatorio">*</span></label>
                        <input type="number" id="garantia_meses" name="garantia_meses" min="0" required>
                    </div>
                </div>
            </div>

            <!-- 3: PREÇO -->
            <div class="form-grid-2">
                <div class="campo">
                    <label for="preco">Preço (R$) <span class="obrigatorio">*</span></label>
                    <input type="number" id="preco" name="preco" step="0.01" min="0" required>
            </div>
            <div class="campo">
                <label for="preco_original">Preço original (se houver desconto)</label>
                <input type="number" id="preco_original" name="preco_original" step="0.01" min="0">
            </div>
            </div>

            <div class="campo">
                <label for="parcelas">Nº de parcelas (sem juros)</label>
                <input type="number" id="parcelas" name="parcelas" min="1" value="1">
            </div>

            <div class="form-botoes">
                <a href="/admin/produtos" class="btn-cancelar">Cancelar</a>
                <button type="submit" class="btn-salvar">
                    <i class="bi bi-floppy2-fill"></i> Registrar Produto
                </button>
            </div>

        </form>
    </div>
    </main>

    <!-- MODAL: ADICIONAR CATEGORIA -->
    <%- include('partials/modalCategoria', { erroCategoria: typeof erroCategoria !== 'undefined' ? erroCategoria : null }) %>

<script>
    // Quando clicar no link "Mudar foto"
    document.getElementById('btnMudarFoto').addEventListener('click', function(e) {
        e.preventDefault(); 
        document.getElementById('inputFoto').click(); 
    });

    // Quando o admin escolher o arquivo na "aba do computador"
    document.getElementById('inputFoto').addEventListener('change', function() {
        if (this.files && this.files[0]) {
            document.getElementById('formFoto').submit();
        }
    });
</script>

</body>
</html>