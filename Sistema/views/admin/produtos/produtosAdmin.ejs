<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RP Celulares</title>

    <!-- BOOTSTRAP -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- ICONS -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <link rel="stylesheet" href="/stylesheets/admin.css">
</head>

<body>

<!-- NAVBAR -->
<header class="navbar">

    <div class="logo">
        RP
    </div>

    <nav class="nav-buttons">
        <a href="/admin">Consertos</a>
        <a href="/admin/produtos">Produtos</a>
        <a href="/admin/clientes">Clientes</a>
    </nav>

    <div class="search-area">
        <input
            type="text"
            id="txtBusca"
            placeholder="Procurar produtos">

        <i class="bi bi-search search-icon"></i>
    </div>

    <!-- ÁREA DO ADMIN -->
    <div class="user-menu-container">

        <div class="user">

            <img
                src="<%= usuario.foto || '/images/valentina.jpg' %>"
                class="user-photo"
                id="fotoPerfil"
                alt="Foto do usuário">

            <span>Admin - Rodrigo</span>

        </div>

        <div class="user-dropdown">

            <a href="#" id="btnMudarFoto">
                <i class="bi bi-camera-fill"></i>
                Mudar foto
            </a>

            <a href="/logout" class="btn-sair">
                <i class="bi bi-box-arrow-right"></i>
                Sair do sistema
            </a>

        </div>

    </div>

    <!-- FORMULÁRIO ESCONDIDO PARA UPLOAD -->
    <form
        id="formFoto"
        action="/admin/upload-foto"
        method="POST"
        enctype="multipart/form-data"
        style="display:none;">
        <input
            type="file"
            id="inputFoto"
            name="foto"
            accept="image/*">
    </form>

</header>


<!-- MENU LATERAL -->
<aside class="sidebar">
    <ul>
        <li class="<%= paginaAtual === 'inicio' ? 'active' : '' %>">
            <a href="/admin/produtos">
                <i class="bi bi-house-fill"></i>
                <span>Início</span>
            </a>
        </li>


        <li class="<%= paginaAtual === 'adicionar-produto' ? 'active' : '' %>">
            <a href="/admin/produtos/adicionar">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Adicionar produtos</span>
            </a>
        </li>


        <li>
            <a href="#" onclick="abrirModalCategoria(); return false;">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Adicionar categoria</span>
            </a>
        </li>
        
        <li class="<%= paginaAtual === 'estoque' ? 'active' : '' %>">
            <a href="/admin/produtos/estoque">
                <i class="bi bi-gear-fill"></i>
                <span>Estoque de produtos</span>
            </a>
        </li>

        <hr>

        <% categorias.forEach(categoria => { %>
            <li class="categoria-item <%= categoriaSelecionada == categoria.id_categoria ? 'active' : '' %>">
                <a href="/admin/produtos?categoria=<%= categoria.id_categoria %>">
                    <span>
                        <%= categoria.nome %>
                    </span>
                </a>

                <button
                    type="button"
                    class="btn-excluir-categoria"
                    onclick="abrirModalExcluirCategoria(
                        '<%= categoria.id_categoria %>',
                        '<%= categoria.nome %>'
                    )"
                    title="Excluir categoria">
                    <i class="bi bi-trash-fill"></i>
                </button>
            </li>
        <% }) %>
    </ul>
</aside>


<!-- ÁREA PRINCIPAL -->
<main class="content">

<!-- CARROSSEL -->
<div class="container-banner-admin">

    <% if (banners.length === 0) { %>

        <!-- SEM BANNERS -->
        <div class="banner-vazio">
            <img 
                src="/images/banner-erro.png" 
                alt="Não há nenhum banner adicionado no carrossel no momento">
        </div>

    <% } else { %>

        <!-- COM BANNERS -->
        <div id="carouselAdmin" class="carousel slide">

            <div class="carousel-inner">

                <% banners.forEach((banner, index) => { %>

                    <div class="carousel-item <%= index === 0 ? 'active' : '' %>">

                        <div class="banner-item">

                            <img 
                                src="/images/banners/<%= banner.imagem %>" 
                                class="d-block w-100" 
                                alt="Banner promocional">

                            <!-- LIXEIRA -->
                            <form 
                                action="/admin/produtos/banners/<%= banner.id_banner %>/excluir" 
                                method="POST" 
                                class="form-excluir-banner">

                                <button 
                                    type="submit" 
                                    class="btn-excluir-banner"
                                    title="Excluir banner">
                                    <i class="bi bi-trash-fill"></i>
                                </button>

                            </form>

                        </div>

                    </div>

                <% }) %>

            </div>


            <!-- SETA ESQUERDA -->
            <% if (banners.length > 1) { %>

                <button 
                    class="carousel-control-prev" 
                    type="button"
                    data-bs-target="#carouselAdmin"
                    data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>


                <!-- SETA DIREITA -->

                <button 
                    class="carousel-control-next" 
                    type="button"
                    data-bs-target="#carouselAdmin"
                    data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                    <span class="visually-hidden">Próximo</span>
                </button>

            <% } %>


            <!-- RISQUINHOS -->

            <% if (banners.length > 1) { %>

                <div class="carousel-indicators">

                    <% banners.forEach((banner, index) => { %>

                        <button 
                            type="button"
                            data-bs-target="#carouselAdmin"
                            data-bs-slide-to="<%= index %>"
                            class="<%= index === 0 ? 'active' : '' %>"
                            aria-current="<%= index === 0 ? 'true' : 'false' %>"
                            aria-label="Banner <%= index + 1 %>"
                        ></button>

                    <% }) %>

                </div>

            <% } %>

        </div>

    <% } %>


    <!-- BOTÃO ADICIONAR BANNER -->

    <button 
        type="button" 
        class="btn-adicionar-banner" 
        onclick="abrirModalBanner()">
        <i class="bi bi-plus-circle-fill"></i>
        Adicionar banner
    </button>

</div>

    <!-- MAIS VENDIDOS -->
    <h2><%= categoriaSelecionada ? 'Produtos da categoria' : 'Mais Vendidos na Loja' %></h2>

    <% if (produtos.length === 0) { %>
        <p class="sem-produtos">Nenhum produto cadastrado ainda.</p>
    <% } else { %>
        <div class="produtos-grid">
            <% produtos.forEach(produto => { %>
                <div class="produto-card">

                    <img src="/images/produtos/<%= produto.foto %>" alt="<%= produto.nome %>">

                    <p class="produto-nome"><%= produto.nome %></p>

                    <hr class="produto-linha">

                    <div class="produto-preco-linha">
                        <% if (produto.preco_original) { %>
                            <span class="preco-riscado">R$ <%= Number(produto.preco_original).toFixed(2).replace('.', ',') %></span>
                        <% } %>
                        <span class="preco-atual">R$ <%= Number(produto.preco).toFixed(2).replace('.', ',') %></span>
                    </div>

                    <% if (produto.parcelas > 1) { %>
                        <% const valorParcela = (Number(produto.preco) / produto.parcelas).toFixed(2).replace('.', ','); %>
                        <span class="produto-parcelas">
                            <%= produto.parcelas %>x de R$ <%= valorParcela %> sem juros
                        </span>
                    <% } %>

                    <div class="produto-acoes">
                        <button type="button" class="btn-comprar">
                            <i class="bi bi-bag-fill"></i> Comprar
                        </button>
                        <a href="/admin/produtos/<%= produto.id_produto %>/editar" class="btn-editar-produto" title="Editar produto">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </div>

                    <% if (produto.estoque === 0) { %>
                        <span class="produto-sem-estoque">Sem estoque</span>
                    <% } %>

                </div>
            <% }) %>
        </div>
    <% } %>
</main>

    <!-- MODAIS -->
<%- include('partials/modalCategoria', { erroCategoria: typeof erroCategoria !== 'undefined' ? erroCategoria : null }) %>
<%- include('partials/modalExcluirCategoria', { erroExcluirCategoria: typeof erroExcluirCategoria !== 'undefined' ? erroExcluirCategoria : null }) %>
<%- include('partials/modalBanner') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Quando clicar no link "Mudar foto"
    document.getElementById('btnMudarFoto').addEventListener('click', function(e) {
        e.preventDefault(); 
        document.getElementById('inputFoto').click(); 
    });

    // Quando o admin escolher o arquivo na "aba do computador"
    document.getElementById('inputFoto').addEventListener('change', function() {
        if (this.files && this.files[0]) {
            document.getElementById('formFoto').submit();
        }
    });
</script>
</body>
</html>