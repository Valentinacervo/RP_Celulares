<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RP Celulares</title>
    <link rel="stylesheet" href="/stylesheets/admin.css">
</head>
<body>
    <!-- NAVBAR -->
    <%- include("../partials/navbar") %>

    <!-- CAIXA DE AVISOS IMPORTANTES -->
    <div class="avisos-container">
        <div class="avisos-header">
            <h3>
                <i class="bi bi-bell-fill"></i>
                Avisos Importantes
                <span id="badge-avisos" class="badge-avisos">0</span>
            </h3>
            <i class="bi bi-arrow-right-circle-fill" id="ver-historico" title="Ver histórico"></i>
        </div>
            
            <div class="avisos-lista" id="lista-avisos">
                <div class="aviso-item">
                    <div class="aviso-icone">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div class="aviso-conteudo">
                    <p>Carregando avisos...</p>
                    <small>aguarde</small>
                </div>
            </div>
        </div>
    </div>
</body>
</html>