<!-- MODAL: ADICIONAR CATEGORIA -->
<div id="modalCategoria" class="modal-overlay">
    <div class="modal-box">

        <div class="modal-header">
            <h2>Adicionar nova categoria</h2>
            <button type="button" class="modal-fechar" onclick="fecharModalCategoria()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <% if (typeof erroCategoria !== "undefined" && erroCategoria) { %>
            <div class="mensagem mensagem--erro"><%= erroCategoria %></div>
        <% } %>

        <form action="/admin/produtos/categorias/adicionar" method="POST">

            <div class="campo">
                <label for="modalNome">Nome <span class="obrigatorio">*</span></label>
                <input type="text" id="modalNome" name="nome" placeholder="Nome da categoria" maxlength="50" required>
            </div>

            <div class="modal-botoes">
                <button type="button" class="btn-cancelar" onclick="fecharModalCategoria()">Fechar</button>
                <button type="submit" class="btn-salvar">Salvar</button>
            </div>

        </form>

    </div>
</div>

<script>
    function abrirModalCategoria() {
        document.getElementById("modalCategoria").classList.add("ativo");
    }

    function fecharModalCategoria() {
        document.getElementById("modalCategoria").classList.remove("ativo");
    }
</script>
