<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - RP Celulares</title>
    <link rel="stylesheet" href="/stylesheets/admin.css">
    <!--ICONES-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body>
    <!-- NAVBAR -->
    <header class="navbar">
        <div class="logo">
            RP
        </div>

        <nav class="nav-buttons">
            <a href="/admin" class="active">Consertos</a>
            <a href="/admin/clientes">Clientes</a>
        </nav>

        <form class="search-area" action="<%= acao %>" method="GET">
            <input type="text" name="busca" value="<%= busca %>" placeholder="Buscar por código, serviço ou cliente">
            <i class="bi bi-search search-icon"></i>
        </form>

        <!-- Área do Admin com Dropdown-->
    <div class="user-menu-container">
      <div class="user">
        <i class="bi bi-person-circle user-icon"></i>
        <span>Admin - Rodrigo</span>
      </div>

      <div class="user-dropdown">
        <a href="/logout" class="btn-sair">
          <i class="bi bi-box-arrow-right"></i> Sair do sistema
        </a>
      </div>
    </div>

    </header>

    <!-- MENU LATERAL -->
    <aside class="sidebar sidebar-consertos">
        <ul>
            <li>
                <a href="/admin">
                    <i class="bi bi-house-fill"></i>
                    <span>Início</span>
                </a>
            </li>

            <li class="<%= pagina === 'destacados' ? 'active' : '' %>">
                <a href="/admin/destacados">
                    <i class="bi bi-star-fill"></i>
                    <span>Destacados</span>
                </a>
            </li>

            <hr>

            <li>
                <a href="/admin/adicionarconserto">
                    <i class="bi bi-plus-circle-fill"></i>
                    <span>Adicionar conserto</span>
                </a>
            </li>

            <li class="<%= pagina === 'todos' ? 'active' : '' %>">
                <a href="/admin/todosconsertos">
                    <i class="bi bi-wrench"></i>
                    <span>Todos os consertos</span>
                </a>
            </li>

            <li class="<%= pagina === 'pendentes' ? 'active' : '' %>">
                <a href="/admin/consertospendentes">
                    <i class="bi bi-hourglass-split"></i>
                    <span>Consertos pendentes</span>
                </a>
            </li>

            <li class="<%= pagina === 'concluidos' ? 'active' : '' %>">
                <a href="/admin/consertosconcluidos">
                    <i class="bi bi-check-circle-fill"></i>
                    <span>Consertos concluídos</span>
                </a>
            </li>
        </ul>
    </aside>

    <!-- ÁREA PRINCIPAL -->
    <main class="content">
        <h1><%= tituloPagina %></h1>
        <hr id="linhaPainel">

        <% if (consertos.length === 0) { %>
            <p class="sem-produtos"><%= busca ? 'Nenhum conserto encontrado para essa busca.' : vazio %></p>
        <% } else { %>
            <div class="clientes-lista conserto-lista">
                <% consertos.forEach(conserto => { %>

                    <div class="cliente-card conserto-card">

                        <div class="cliente-topo">
                            <div class="cliente-nome-codigo">
                                <strong><%= conserto.servico %></strong>
                                <span class="cliente-codigo">#<%= conserto.codigo %></span>

                                <% if (mostrarStatus) { %>
                                    <% if (conserto.status === 'concluido') { %>
                                        <span class="conserto-status conserto-status--concluido">Concluído</span>
                                    <% } else { %>
                                        <span class="conserto-status conserto-status--pendente">Pendente</span>
                                    <% } %>
                                <% } %>
                            </div>

                            <div class="conserto-acoes">
                                <button type="button"
                                        class="btn-estrela <%= conserto.destacado ? 'ativa' : '' %>"
                                        data-id="<%= conserto.id_conserto %>"
                                        title="<%= conserto.destacado ? 'Remover dos destacados' : 'Destacar conserto' %>"
                                        aria-label="Destacar conserto">
                                    <i class="bi <%= conserto.destacado ? 'bi-star-fill' : 'bi-star' %>"></i>
                                </button>

                                <a href="/admin/consertos/<%= conserto.codigo %>" class="btn-ver-detalhes">
                                    <i class="bi bi-eye-fill"></i> Ver Detalhes
                                </a>
                            </div>

                        </div>

                        <div class="cliente-contato">
                            <span>
                                <i class="bi bi-calendar-event-fill"></i>
                                Abertura: <%= conserto.data_abertura %>
                            </span>

                            <span>
                                <i class="bi bi-calendar-check-fill"></i>
                                Entrega prevista: <%= conserto.data_prevista %>
                            </span>
                        </div>

                        <hr class="cliente-linha">

                        <div class="cliente-servico">
                            Solicitado por: <%= conserto.cliente || 'Cliente não encontrado' %>
                        </div>

                    </div>
                <% }) %>
            </div>
        <% } %>
    </main>

    <script>
        // Destacados 
        const naPaginaDestacados = <%= pagina === 'destacados' %>;
        const mensagemVazia = <%- JSON.stringify(vazio || '') %>;

        function atualizarEstrela(botao, destacado) {
            botao.classList.toggle('ativa', destacado);
            botao.title = destacado ? 'Remover dos destacados' : 'Destacar conserto';

            const icone = botao.querySelector('i');
            icone.classList.toggle('bi-star-fill', destacado);
            icone.classList.toggle('bi-star', !destacado);
        }

        // O card some quando a estrela é desmarcada
        function removerCard(card) {
            card.style.transition = 'opacity 0.25s';
            card.style.opacity = '0';

            setTimeout(function() {
                const lista = card.parentElement;
                card.remove();

                if (lista.children.length === 0) {
                    const aviso = document.createElement('p');
                    aviso.className = 'sem-produtos';
                    aviso.textContent = mensagemVazia;
                    lista.replaceWith(aviso);
                }
            }, 250);
        }

        document.querySelectorAll('.btn-estrela').forEach(function(botao) {
            botao.addEventListener('click', async function() {
                botao.disabled = true;

                try {
                    const resposta = await fetch('/admin/consertos/' + botao.dataset.id + '/destacar', { method: 'POST' });
                    if (!resposta.ok) throw new Error('Falha ao destacar');

                    const dados = await resposta.json();
                    atualizarEstrela(botao, dados.destacado);

                    if (naPaginaDestacados && !dados.destacado) {
                        removerCard(botao.closest('.conserto-card'));
                    }
                } catch (erro) {
                    alert('Não foi possível atualizar o destaque. Tente novamente.');
                } finally {
                    botao.disabled = false;
                }
            });
        });
    </script>
</body>
</html>