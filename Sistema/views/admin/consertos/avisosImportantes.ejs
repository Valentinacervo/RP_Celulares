<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RP Celulares - Avisos Importantes</title>
    <link rel="stylesheet" href="/stylesheets/admin.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <!--ICONES-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body>
    <!-- NAVBAR -->
    <header class="navbar navbar--sem-busca">
    <div class="logo">
        RP 
    </div>

    <nav class="nav-buttons">
        <a href="/admin" class="ativo">Consertos</a>
        <a href="/admin/produtos">Produtos</a>
        <a href="/admin/clientes">Clientes</a>
    </nav>

    <!-- Área do Admin com Dropdown-->
    <div class="user-menu-container">
        <div class="user">
            <img src="<%= usuario.foto || '/images/valentina.jpg' %>" class="user-photo" id="fotoPerfil" alt="Foto do usuário">
            <span>Admin - Rodrigo </span>
        </div>
        
        <div class="user-dropdown">
            <a href="#" id="btnMudarFoto">
                <i class="bi bi-camera-fill"></i> Mudar foto
            </a>
            <a href="/logout" class="btn-sair">
                <i class="bi bi-box-arrow-right"></i> Sair do sistema
            </a>
        </div>
    </div>

    <!-- FORMULÁRIO ESCONDIDO PARA UPLOAD -->
    <form id="formFoto" action="/admin/upload-foto" method="POST" enctype="multipart/form-data" style="display: none;">
        <input type="file" id="inputFoto" name="foto" accept="image/*">
    </form>
</header>

    <!-- ÁREA PRINCIPAL -->
    <main class="content avisos-pagina">

        <div class="avisos-cabecalho">
            <div class="avisos-titulo">
                <a href="/admin" class="painel-avisos-seta" title="Voltar ao painel" aria-label="Voltar ao painel">
                    <i class="bi bi-chevron-left"></i>
                </a>
                <h1>Avisos Importantes</h1>
            </div>

            <!-- FILTRO -->
            <div class="avisos-filtro" id="avisosFiltro">
                <button type="button" class="avisos-filtro-botao" id="btnFiltro" aria-haspopup="true" aria-expanded="false" title="Filtrar avisos">
                    <i class="bi bi-funnel-fill"></i>
                    <span id="filtroRotulo">Todos</span>
                    <i class="bi bi-chevron-down avisos-filtro-seta"></i>
                </button>

                <ul class="avisos-filtro-menu" id="menuFiltro" role="menu">
                    <li><button type="button" role="menuitemradio" class="avisos-filtro-opcao ativo" data-filtro="todos" aria-checked="true">Todos</button></li>
                    <li><button type="button" role="menuitemradio" class="avisos-filtro-opcao" data-filtro="conserto" aria-checked="false">Conserto</button></li>
                    <li><button type="button" role="menuitemradio" class="avisos-filtro-opcao" data-filtro="loja" aria-checked="false">Loja Online</button></li>
                </ul>
            </div>
        </div>

        <!-- TABELA DE AVISOS -->
        <div class="avisos-tabela" role="table" aria-label="Avisos importantes">
            <div class="avisos-colunas" role="row">
                <span role="columnheader">Tipo de Aviso</span>
                <span role="columnheader">Descrição</span>
                <span role="columnheader">Data</span>
            </div>

            <div class="avisos-linhas" id="listaAvisos">
                <% avisos.forEach((aviso, i) => { %>
                    <div class="aviso-linha <%= i % 2 === 0 ? 'aviso-linha--cinza' : '' %>" role="row" data-categoria="<%= aviso.categoria %>">
                        <span class="aviso-tipo" role="cell">
                            <img src="<%= aviso.icone %>" alt="" class="aviso-icone">
                            <span><%= aviso.titulo %></span>
                        </span>
                        <span class="aviso-descricao" role="cell"><% aviso.descricao.forEach(parte => { %><% if (parte.italico) { %><em><%= parte.texto %></em><% } else { %><%= parte.texto %><% } %><% }) %></span>
                        <span class="aviso-data" role="cell"><%= aviso.data %></span>
                    </div>
                <% }) %>
            </div>

            <p class="avisos-vazio" id="avisosVazio" style="display: <%= avisos.length ? 'none' : 'block' %>;">Nenhum aviso no momento.</p>
        </div>
    </main>

<script>
    // Quando clicar no link "Mudar foto"
    document.getElementById('btnMudarFoto').addEventListener('click', function(e) {
        e.preventDefault();
        document.getElementById('inputFoto').click();
    });

    // Quando o admin escolher o arquivo na "aba do computador"
    document.getElementById('inputFoto').addEventListener('change', function() {
        if (this.files && this.files[0]) {
            document.getElementById('formFoto').submit();
        }
    });

    // ---------- FILTRO DE AVISOS ----------
    const caixaFiltro = document.getElementById('avisosFiltro');
    const btnFiltro = document.getElementById('btnFiltro');
    const filtroRotulo = document.getElementById('filtroRotulo');
    const opcoesFiltro = document.querySelectorAll('.avisos-filtro-opcao');
    const linhasAvisos = document.querySelectorAll('#listaAvisos .aviso-linha');
    const avisosVazio = document.getElementById('avisosVazio');

    function abrirMenu(abrir) {
        caixaFiltro.classList.toggle('aberto', abrir);
        btnFiltro.setAttribute('aria-expanded', String(abrir));
    }

    function aplicarFiltro(filtro) {
        let visiveis = 0;

        linhasAvisos.forEach(function(linha) {
            const mostrar = filtro === 'todos' || linha.dataset.categoria === filtro;
            linha.style.display = mostrar ? '' : 'none';

            // Refaz a alternância de cores só entre as linhas que aparecem
            linha.classList.remove('aviso-linha--cinza');
            if (mostrar) {
                if (visiveis % 2 === 0) linha.classList.add('aviso-linha--cinza');
                visiveis++;
            }
        });

        avisosVazio.textContent = filtro === 'todos' ? 'Nenhum aviso no momento.' : 'Nenhum aviso nesta categoria.';
        avisosVazio.style.display = visiveis ? 'none' : 'block';
    }

    btnFiltro.addEventListener('click', function(e) {
        e.stopPropagation();
        abrirMenu(!caixaFiltro.classList.contains('aberto'));
    });

    opcoesFiltro.forEach(function(opcao) {
        opcao.addEventListener('click', function() {
            opcoesFiltro.forEach(function(o) {
                o.classList.remove('ativo');
                o.setAttribute('aria-checked', 'false');
            });
            opcao.classList.add('ativo');
            opcao.setAttribute('aria-checked', 'true');

            filtroRotulo.textContent = opcao.textContent;
            aplicarFiltro(opcao.dataset.filtro);
            abrirMenu(false);
        });
    });

    document.addEventListener('click', function(e) {
        if (!caixaFiltro.contains(e.target)) abrirMenu(false);
    });

    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') abrirMenu(false);
    });
</script>
</body>
</html>