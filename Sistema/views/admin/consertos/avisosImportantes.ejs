<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RP Celulares - Avisos Importantes</title>
    <link rel="stylesheet" href="/stylesheets/admin.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600&display=swap" rel="stylesheet">
    <!--ICONES-->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
</head>

<body>
    <!-- NAVBAR -->
    <header class="navbar navbar--sem-busca">
    <div class="logo">
        RP 
    </div>

    <nav class="nav-buttons">
        <a href="/admin" class="ativo">Consertos</a>
        <a href="/admin/clientes">Clientes</a>
    </nav>

    <!-- Área do Admin com Dropdown-->
    <div class="user-menu-container">
        <div class="user">
            <img src="<%= usuario.foto || '/images/valentina.jpg' %>" class="user-photo" id="fotoPerfil" alt="Foto do usuário">
            <span>Admin - Rodrigo </span>
        </div>
        
        <div class="user-dropdown">
            <a href="#" id="btnMudarFoto">
                <i class="bi bi-camera-fill"></i> Mudar foto
            </a>
            <a href="/logout" class="btn-sair">
                <i class="bi bi-box-arrow-right"></i> Sair do sistema
            </a>
        </div>
    </div>

    <!-- FORMULÁRIO ESCONDIDO PARA UPLOAD -->
    <form id="formFoto" action="/admin/upload-foto" method="POST" enctype="multipart/form-data" style="display: none;">
        <input type="file" id="inputFoto" name="foto" accept="image/*">
    </form>
</header>

    <!-- ÁREA PRINCIPAL -->
    <main class="content avisos-pagina">

        <!-- TÍTULO CENTRALIZADO -->
        <div class="avisos-cabecalho">
            <div class="avisos-titulo">
                <a href="/admin" class="painel-avisos-seta"
                   title="Voltar ao painel"
                   aria-label="Voltar ao painel">
                    <i class="bi bi-chevron-left"></i>
                </a>

                <h1>Avisos Importantes</h1>
            </div>
        </div>

        <!-- TABELA DE AVISOS -->
        <div class="avisos-tabela" role="table"
             aria-label="Avisos importantes">

            <div class="avisos-colunas" role="row">
                <span role="columnheader">Tipo de Aviso</span>
                <span role="columnheader">Descrição</span>
                <span role="columnheader">Data</span>
            </div>

            <div class="avisos-linhas" id="listaAvisos">
                <% avisos.forEach((aviso, i) => { %>
                    <div class="aviso-linha <%= i % 2 === 0 ? 'aviso-linha--cinza' : '' %>"
                         role="row">

                        <span class="aviso-tipo" role="cell">
                            <img src="<%= aviso.icone %>" alt=""
                                 class="aviso-icone">
                            <span><%= aviso.titulo %></span>
                        </span>

                        <span class="aviso-descricao" role="cell"><% aviso.descricao.forEach(parte => { %><% if (parte.italico) { %><em><%= parte.texto %></em><% } else { %><%= parte.texto %><% } %><% }) %></span>

                        <span class="aviso-data" role="cell">
                            <%= aviso.data %>
                        </span>
                    </div>
                <% }) %>
            </div>

            <p class="avisos-vazio" id="avisosVazio"
               style="display: <%= avisos.length ? 'none' : 'block' %>;">
                Nenhum aviso no momento.
            </p>

        </div>
    </main>

<script>
    // Quando clicar no link "Mudar foto"
    document.getElementById('btnMudarFoto').addEventListener('click', function(e) {
        e.preventDefault();
        document.getElementById('inputFoto').click();
    });

    // Quando o admin escolher o arquivo na "aba do computador"
    document.getElementById('inputFoto').addEventListener('change', function() {
        if (this.files && this.files[0]) {
            document.getElementById('formFoto').submit();
        }
    });
</script>
</body>
</html>